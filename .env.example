# Copy to .env and fill in. Used by `npm run docs:deploy` inside the docs container.
# Token: Cloudflare dashboard > My Profile > API Tokens > Create Token,
# custom token with permission Account > Cloudflare Pages > Edit.
CLOUDFLARE_API_TOKEN=
# Account ID: shown on the Cloudflare dashboard home (Account details).
CLOUDFLARE_ACCOUNT_ID=
